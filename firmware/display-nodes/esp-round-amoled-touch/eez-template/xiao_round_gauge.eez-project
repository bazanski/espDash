{
  "version": "1.0.0",
  "projectType": "lvgl",
  "settings": {
    "general": {
      "name": "xiao_round_gauge",
      "description": "espDash XIAO Round Universal Telemetry Gauge EEZ Studio Template",
      "lvglVersion": "8.3",
      "displayWidth": 240,
      "displayHeight": 240,
      "displayColorDepth": 16,
      "targetPlatform": "ESP32-S3"
    },
    "build": {
      "outputDirectory": "../src/ui",
      "namingConvention": "snake_case",
      "generateC": true
    }
  },
  "styles": [
    {
      "name": "style_main",
      "bg_color": "#0b0f19",
      "text_color": "#00f0ff"
    },
    {
      "name": "style_theme_18",
      "bg_color": "#000000",
      "card_bg": "#121212",
      "accent_primary": "#DBCFCF",
      "accent_secondary": "#9A9797",
      "text_color": "#FFFFFF",
      "border_color": "#FFFFFF"
    }
  ],
